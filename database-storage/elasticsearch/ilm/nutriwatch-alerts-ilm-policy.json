{
  "_comment": "ILM Policy untuk index nutriwatch-alerts. Tujuan: menjaga performa query dashboard (hot tier) dan memastikan retensi data sesuai kebutuhan investigasi historis (default 90 hari sebelum dihapus dari ES; arsip jangka panjang ada di HDFS).",
  "policy": {
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": {
            "max_age": "1d",
            "max_primary_shard_size": "5gb"
          },
          "set_priority": {
            "priority": 100
          }
        }
      },
      "warm": {
        "min_age": "7d",
        "actions": {
          "shrink": {
            "number_of_shards": 1
          },
          "set_priority": {
            "priority": 50
          }
        }
      },
      "delete": {
        "min_age": "90d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
