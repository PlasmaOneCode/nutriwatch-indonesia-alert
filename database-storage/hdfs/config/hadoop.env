# =========================================================================
# NutriWatch - HDFS Configuration (hadoop.env)
# Tugas: Daniswara Fausta Novanto - Database & Storage Engineer
#
# File ini di-mount ke seluruh container HDFS (namenode & datanode)
# untuk menyamakan konfigurasi core-site & hdfs-site.
# =========================================================================

CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
CORE_CONF_hadoop_proxyuser_hue_hosts=*
CORE_CONF_hadoop_proxyuser_hue_groups=*
CORE_CONF_io_compression_codecs=org.apache.hadoop.io.compress.SnappyCodec

HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_name_dir=file:///hadoop/dfs/name
HDFS_CONF_dfs_datanode_data_dir=file:///hadoop/dfs/data

# Replication factor = 2 (sesuai jumlah datanode pada lab environment)
HDFS_CONF_dfs_replication=2

# Block size 128MB (default Hadoop 3.x) - cukup untuk volume data MBG harian
HDFS_CONF_dfs_blocksize=134217728
